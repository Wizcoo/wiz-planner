{
  "name": "wiz-planner",
  "version": "1.0.0",
  "description": "A macOS-inspired, local-first team planner with Gantt timelines, calendars, daily to-dos, and portable HTML backups.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wizcoo/wiz-planner.git"
  },
  "engines": { "node": ">=24" },
  "type": "module",
  "private": true,
  "scripts": {
    "planner:build": "node scripts/build-planner.mjs",
    "test:planner": "node --test test/planner.test.mjs",
    "predev": "npm run planner:build",
    "prebuild": "npm run planner:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-all.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.39.3",
    "lucide-react": "^0.475.0",
    "next": "15.1.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.1.7",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
